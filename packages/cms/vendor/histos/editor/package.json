{
  "name": "@xb/editor",
  "version": "0.1.0",
  "private": true,
  "description": "XB builder UI (Svelte 5 + CodeMirror 6). Built into plugin/assets/builder.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build -c vite.gutenberg.config.ts && vite build -c vite.gutenberg-code.config.ts && vite build -c vite.media.config.ts && vite build -c vite.histos-css.config.ts",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte-check": "^4.7.7",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@jsquash/avif": "2.1.1",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "svelte": "^5.57.2",
    "wasm-feature-detect": "1.9.0"
  }
}
