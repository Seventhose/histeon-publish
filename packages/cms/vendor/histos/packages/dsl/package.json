    "typecheck": "tsc --noEmit -p .",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@wordpress/block-serialization-default-parser": "^5.57.0"
  },
  "bin": {
    "xb-dsl": "bin/xb-dsl.js"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ]
