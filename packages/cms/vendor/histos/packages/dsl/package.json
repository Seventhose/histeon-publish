{
  "name": "@xb/dsl",
  "version": "0.1.0",
  "description": "XB template DSL: parser, printer and Gutenberg block-grammar mapping (reference implementation of docs/spec).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sheet": "./src/sheet.ts",
    "./scss": "./src/scss.ts"
  },
  "scripts": {
