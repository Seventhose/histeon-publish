FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d

WORKDIR /app

# The server package also serves the CMS, so the agent image carries its workspaces: cms, histos-contract, the
# vendored Histeon spec (JSON schemas) and the local bcrypt-pbkdf. Build first with `npm run build`.
COPY package.json package-lock.json ./
COPY packages/core/package.json packages/core/package.json
COPY packages/cli/package.json packages/cli/package.json
COPY packages/server/package.json packages/server/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/desktop/package.json packages/desktop/package.json
COPY packages/cf-mock/package.json packages/cf-mock/package.json
COPY packages/histos-contract/package.json packages/histos-contract/package.json
COPY packages/cms/package.json packages/cms/package.json
COPY packages/bcrypt-pbkdf packages/bcrypt-pbkdf
COPY packages/cms/vendor/histos/packages/dsl/package.json packages/cms/vendor/histos/packages/dsl/package.json
COPY packages/cms/vendor/histos/packages/spec packages/cms/vendor/histos/packages/spec
COPY packages/cms/vendor/histos/editor/package.json packages/cms/vendor/histos/editor/package.json

RUN npm ci --omit=dev --ignore-scripts \
  --workspace=@histos-publish/core \
  --workspace=@histos-publish/server \
  --workspace=@histos-publish/cli \
  --include-workspace-root=false

COPY packages/core/dist packages/core/dist
COPY packages/cli/dist packages/cli/dist
COPY packages/server/dist packages/server/dist
COPY packages/histos-contract/dist packages/histos-contract/dist
COPY packages/cms/dist packages/cms/dist
COPY packages/cms/.generated/histos-dsl packages/cms/.generated/histos-dsl
COPY packages/cms/assets packages/cms/assets

RUN install -d -o 10001 -g 10001 -m 0700 /var/lib/histos-publish-agent

ENV NODE_ENV=production
USER 10001:10001

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:8787/healthz',r=>process.exit(r.statusCode===204?0:1)).on('error',()=>process.exit(1))"

ENTRYPOINT ["node", "packages/cli/dist/index.js"]
CMD ["agent", "--config", "/etc/histos-publish/agent.json"]
